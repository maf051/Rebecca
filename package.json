    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "8.0.0-rc.35",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "4.1.4",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@effect/platform-node-shared": "4.1.4"
